MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillup-hub?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@skillup.ed
ADMIN_PASSWORD=change-this-password

# Brevo (transactional email) — used for password reset emails and any future mailing.
# Get an API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@sarvprathamanalytics.com
BREVO_SENDER_NAME=Sarvpratham Analytics

# Cashfree PG Credentials
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Meta WhatsApp Business Cloud API — sends a purchase confirmation message on checkout.
# Get these from https://business.facebook.com (WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=course_purchase
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
